<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Relay traffic (wss) and the Firebase/FCM registration once the user imports a Firebase config. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime permission, requested only when the user enables push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- User-confirmed APK updates, only through Android's per-app install permission and system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- No storage, camera or location permissions: files go through the system pickers, photos through the
         system camera app. -->

    <application
        android:name=".OmpDeckApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmpDeck"
        android:usesCleartextTraffic="false">

        <!-- The only exported component (the launcher). Notification taps reach it through an explicit
             PendingIntent that carries a per-install secret, so other apps cannot drive it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM delivery: Firebase's own (permission-protected) receiver starts this service. -->
        <service
            android:name=".push.OmpDeckMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Destination of system-camera photos for the web page's file picker. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Read-only grants expose only completed updater APKs, never partial downloads, records or other cache. -->
        <provider
            android:name=".update.UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />
    </application>
</manifest>
