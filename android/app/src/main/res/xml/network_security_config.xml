<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- TLS only, trusting the system store (no user-installed CAs). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
